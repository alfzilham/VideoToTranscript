# Maximum upload/download size in bytes (default 2 GiB)
VTT_MAX_UPLOAD_BYTES=2147483648
# Comma-separated local frontends
VTT_FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Downloader storage and resource limits
VTT_DOWNLOAD_DIR=downloads
VTT_TWITCH_CLIENT_ID=
VTT_TWITCH_ACCESS_TOKEN=
VTT_TWITCH_TOKEN_FILE=
VTT_GOOGLE_DRIVE_OAUTH_CLIENT_FILE=
VTT_GOOGLE_DRIVE_TOKEN_FILE=
VTT_DOWNLOAD_MAX_BYTES=10737418240
VTT_DOWNLOAD_MAX_CONCURRENT=1
VTT_DOWNLOAD_INSPECTION_TTL=900
